# Rename to .env in the project root. Never commit real secrets.
POSTGRES_USER=retail
POSTGRES_PASSWORD=local_demo_change_this
POSTGRES_DB=retail
DATABASE_URL=postgresql+psycopg://retail:local_demo_change_this@db:5432/retail
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEMO_MODE=true
AUTO_INDEX_SAMPLES=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
COMPARISON_EMBEDDING_MODEL=intfloat/e5-small-v2
ENABLE_CROSS_ENCODER=false
