# Enterprise AI Retail Operations & Supply Chain Assistant - Environment Configuration

# Application
PROJECT_NAME="Enterprise AI Retail Operations & Supply Chain Assistant"
PROJECT_VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & JWT Authentication
SECRET_KEY="enterprise-retail-copilot-production-key-2026-secure-jwt"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL default per PDF, or MySQL)
DATABASE_URL="postgresql://postgres:your_password@localhost:5433/retail_copilot_db"
# Example MySQL: DATABASE_URL="mysql+pymysql://root:your_password@localhost:3306/retail_copilot_db"

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY="./data/chroma_db"
VECTOR_DB_COLLECTION="retail_enterprise_knowledge"

# Advanced RAG Configurations
DEFAULT_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
COMPARISON_EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
CHUNK_SIZE=500
CHUNK_OVERLAP=100
PARENT_CHUNK_SIZE=1500
CHILD_CHUNK_SIZE=350
HYBRID_ALPHA=0.60
RERANK_TOP_K=3

# Optional Cloud LLM Keys (Falls back automatically to local deterministic synthesizer if unset)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_MODEL="gemini-1.5-flash"
